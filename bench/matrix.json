{
  "trials": 3,
  "models_env": "BENCH_MODELS",
  "comment": "EVO-5: do not default to the 14B. Missing CLIs SKIP. Pumba is never a harness. Crush is in (FSL allowed internally). IDE-only / SDK-only / G1=no stay out (Zed, Pochi, Gemini, frameworks).",
  "models_prefer": [
    "Qwen3.8",
    "Mistral-Small-4",
    "gpt-oss",
    "Devstral",
    "Qwen3-Coder"
  ],
  "models_skip_substrings": [
    "embed",
    "nomic",
    "bge-",
    "rerank",
    "mmproj"
  ],
  "harnesses": [
    {
      "id": "model_chat",
      "kind": "model",
      "required": true,
      "note": "LLM only: files inlined, no tools. Control for 'what the model knows'."
    },
    {
      "id": "model_tools",
      "kind": "model",
      "required": true,
      "note": "LLM + native OpenAI tool_calls, tiny allowlisted executor. No MCP, no prose fallback, no product UI."
    },
    {
      "id": "opencode",
      "kind": "harness",
      "required": false
    },
    {
